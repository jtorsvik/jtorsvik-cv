---
import Layout from '../layouts/Layout.astro';

// ─── Types ───────────────────────────────────────────────────────────────────
interface Engagement {
  title: string;
  client: string;
  logo?: string;
  period: string;
  bullets: string[];
}

interface Experience {
  employer: string;
  logo: string;
  role: string;
  period: string;
  type: 'consulting' | 'direct';
  engagements?: Engagement[];
  bullets?: string[];
}

interface Education {
  degree: string;
  institution: string;
  period: string;
  grade: string;
  subjects: string[];
}

type CertProvider = 'databricks' | 'azure' | 'terraform' | 'dasca' | 'itil';

interface Cert {
  name: string;
  date: string;
  provider: CertProvider;
}

// ─── Data ────────────────────────────────────────────────────────────────────
const experiences: Experience[] = [
  {
    employer: 'Sopra Steria',
    logo: '/sopra_steria.jpg',
    role: 'Data Scientist Consultant',
    period: 'Aug 2022 – Nov 2023  ·  May 2025 – Present',
    type: 'consulting',
    engagements: [
      {
        title: 'Solution Architect',
        client: 'Anonymous Client',
        period: 'Aug 2025 – Present',
        bullets: [
          'Architectural design for on-premise Spark cluster implementation',
          'Developing secure analytics platform for sensitive data processing',
          'Collaborating with cross-functional teams to establish data governance standards',
          'Optimizing cluster performance and resource utilization',
          'Implementing security protocols and access controls',
        ],
      },
      {
        title: 'Data Scientist',
        client: 'Bane NOR',
        logo: '/bane_nor.jpg',
        period: 'Nov 2023 – May 2025',
        bullets: [
          'Specializing in Deep Learning and Computer Vision algorithms',
          'Experience with streaming and batch data processing',
          'Azure architecture setup and implementation',
        ],
      },
      {
        title: 'Full-stack Data Scientist',
        client: 'Equinor',
        logo: '/equinor.jpg',
        period: 'Aug 2022 – Nov 2023',
        bullets: [
          'Visualization of IT infrastructure and business data',
          'Data pipeline development using Azure Data Factory',
          'Data transformation using Python in Databricks',
          'Power BI modeling and visualization',
        ],
      },
    ],
  },
  {
    employer: 'AON Norway AS',
    logo: '/aon.jpg',
    role: 'Developer',
    period: 'Sep 2018 – Jul 2022',
    type: 'direct',
    bullets: [
      'Microsoft CRM development and administration',
      'Internal process optimization',
      'Ad-hoc analytics for brokers',
    ],
  },
  {
    employer: 'IF / Vertikal Helse',
    logo: '/vertikal_helse.jpg',
    role: 'Financial Assistant',
    period: 'Jul 2017 – Sep 2018',
    type: 'direct',
    bullets: [
      'Accounts payable management',
      'Customer reimbursement processing',
      'Invoice handling',
    ],
  },
  {
    employer: 'POWER AS',
    logo: '/power.jpg',
    role: 'Part-time Sales Representative',
    period: 'Nov 2014 – Sep 2017',
    type: 'direct',
    bullets: [
      'Electronics sales specialist',
      'Locations: Expert Drotningsvik (Bergen) and Power Colosseum (Oslo)',
    ],
  },
];

const education: Education[] = [
  {
    degree: 'MSc in Data Science',
    institution: 'University of Sussex',
    period: '2021 – 2022',
    grade: 'B (65%)',
    subjects: ['Machine Learning', 'Natural Language Processing', 'Computer Vision', 'Data Science Techniques'],
  },
  {
    degree: 'Bachelor in Finance',
    institution: 'BI Norwegian Business School',
    period: '2015 – 2018',
    grade: 'C',
    subjects: ['Financial Analytics', 'Corporate Banking', 'Trading', 'Micro and Macroeconomics'],
  },
];

const certifications: Cert[] = [
  { name: 'Terraform Practitioner',                             date: 'Aug 2025', provider: 'terraform'  },
  { name: 'DASCA: Senior Data Scientist',                       date: 'Nov 2024', provider: 'dasca'      },
  { name: 'Databricks: Machine Learning Engineer Professional', date: 'Sep 2025', provider: 'databricks' },
  { name: 'Databricks: Generative AI Engineer',                 date: 'Mar 2025', provider: 'databricks' },
  { name: 'Databricks: Machine Learning Engineer Associate',    date: 'Mar 2023', provider: 'databricks' },
  { name: 'Databricks: Data Engineering Associate',             date: 'May 2023', provider: 'databricks' },
  { name: 'AI-102: Azure AI Engineer',                          date: 'Feb 2023', provider: 'azure'      },
  { name: 'AI-900: Azure AI Fundamentals',                      date: 'Jan 2023', provider: 'azure'      },
  { name: 'DP-100: Data Science on Azure',                      date: 'Sep 2022', provider: 'azure'      },
  { name: 'DP-203: Azure Data Engineer',                        date: 'Jun 2023', provider: 'azure'      },
  { name: 'PL-300: Power BI Analyst',                           date: 'Dec 2022', provider: 'azure'      },
  { name: 'AZ-104: Azure Administrator',                        date: 'Feb 2023', provider: 'azure'      },
  { name: 'DP-900: Azure Data Fundamentals',                    date: 'Sep 2022', provider: 'azure'      },
  { name: 'ITIL 4 Foundation',                                  date: 'Jan 2023', provider: 'itil'       },
];

const providerMeta: Record<CertProvider, { bg: string; border: string; text: string; label: string }> = {
  databricks: { bg: '#fff5f5', border: '#FF3621', text: '#b91c1c', label: 'Databricks'       },
  azure:      { bg: '#eff7ff', border: '#0078D4', text: '#005a9e', label: 'Microsoft Azure'  },
  terraform:  { bg: '#f5f3ff', border: '#7B42BC', text: '#5b21b6', label: 'HashiCorp'        },
  dasca:      { bg: '#fffbeb', border: '#d97706', text: '#92400e', label: 'DASCA'             },
  itil:       { bg: '#f0fdf4', border: '#059669', text: '#065f46', label: 'AXELOS'            },
};

const skillCategories = [
  { name: '☁️ Cloud Platforms',    skills: ['Azure', 'AWS'] },
  { name: '📊 Big Data & Analytics', skills: ['Databricks', 'Apache Spark', 'HPE Data Fabric', 'Microsoft Fabric', 'Power BI', 'Grafana'] },
  { name: '🐍 Programming',         skills: ['Python', 'SQL / T-SQL / KQL', 'Terraform', 'Bash', 'PowerShell', 'GitHub Actions'] },
  { name: '🧠 Workflow & Process',   skills: ['SCRUM', 'Kanban', 'Product Management', 'MLOps', 'DevOps', 'GenAI-Ops'] },
];

// Prefix public/ assets with the deployment base path
const asset = (path: string) => import.meta.env.BASE_URL + path.replace(/^\//, '');
---

<Layout>

  <!-- ═══════════════════════════════ HERO ═══════════════════════════════════ -->
  <header class="hero">
    <div class="hero-inner">
      <img src={asset('/profile.jpg')} alt="Joakim Martin Torsvik" class="hero-photo" />
      <div class="hero-text">
        <h1 class="hero-name">Joakim Martin Torsvik</h1>
        <p class="hero-title">Data Scientist · Data Engineer · Technical Lead</p>
        <p class="hero-subtitle">Data Platform Architecture &amp; Development · Agile Team Management · Product Development</p>

        <div class="contact-row">
          <span class="contact-pill">📍 Oslo, Norway</span>
          <a href="tel:+4745467412" class="contact-pill">📞 +47 454 67 412</a>
          <a href="mailto:joakim.torsvik@icloud.com" class="contact-pill">✉️ joakim.torsvik@icloud.com</a>
        </div>

        <div class="lang-row">
          <span class="lang-chip">🇳🇴 Norwegian (native)</span>
          <span class="lang-chip">🇬🇧 English (fluent)</span>
          <span class="lang-chip">🇪🇸 Spanish (B2)</span>
        </div>
      </div>
    </div>
  </header>

  <main class="page">

    <!-- ══════════════════════════ SKILLS ══════════════════════════════════ -->
    <section class="section" id="skills">
      <div class="section-heading">
        <span class="section-icon">🛠️</span>
        <h2>Technical Proficiencies</h2>
      </div>
      <div class="skills-grid">
        {skillCategories.map(cat => (
          <div class="skill-card">
            <p class="skill-cat-label">{cat.name}</p>
            <div class="tags">
              {cat.skills.map(s => <span class="tag">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════ EXPERIENCE ════════════════════════════════ -->
    <section class="section" id="experience">
      <div class="section-heading">
        <span class="section-icon">💼</span>
        <h2>Professional Experience</h2>
      </div>
      <div class="timeline">
        {experiences.map(exp => (
          <div class="timeline-entry">
            <div class="timeline-dot" />
            <div class:list={['exp-card', exp.type === 'consulting' && 'exp-card--consulting']}>

              <div class="exp-header">
                <img src={asset(exp.logo)} alt={exp.employer} class="exp-logo" />
                <div>
                  <p class="exp-role">{exp.role}</p>
                  <p class="exp-employer">{exp.employer}</p>
                  <p class="exp-period">{exp.period}</p>
                </div>
              </div>

              {exp.type === 'direct' && exp.bullets && (
                <ul class="bullets">
                  {exp.bullets.map(b => <li>{b}</li>)}
                </ul>
              )}

              {exp.type === 'consulting' && exp.engagements && (
                <div class="engagements">
                  <p class="engagements-label">Client Engagements</p>
                  {exp.engagements.map(eng => (
                    <div class="engagement-card">
                      <div class="engagement-header">
                        {eng.logo
                          ? <img src={asset(eng.logo)} alt={eng.client} class="engagement-logo" />
                          : <div class="engagement-logo engagement-logo--placeholder">?</div>
                        }
                        <div>
                          <p class="engagement-title">{eng.title}</p>
                          <p class="engagement-client">{eng.client}</p>
                          <p class="engagement-period">{eng.period}</p>
                        </div>
                      </div>
                      <ul class="bullets">
                        {eng.bullets.map(b => <li>{b}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              )}

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════════════════ EDUCATION ════════════════════════════════ -->
    <section class="section" id="education">
      <div class="section-heading">
        <span class="section-icon">🎓</span>
        <h2>Education</h2>
      </div>
      <div class="edu-list">
        {education.map(edu => (
          <div class="edu-card">
            <div class="edu-header">
              <div>
                <p class="edu-degree">{edu.degree}</p>
                <p class="edu-institution">{edu.institution}</p>
                <p class="edu-period">{edu.period} · Grade average: {edu.grade}</p>
              </div>
            </div>
            <div class="tags" style="margin-top: 0.75rem;">
              {edu.subjects.map(s => <span class="tag tag--edu">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════ CERTIFICATIONS ═════════════════════════════ -->
    <section class="section" id="certifications">
      <div class="section-heading">
        <span class="section-icon">📜</span>
        <h2>Technical Certifications</h2>
      </div>
      <div class="cert-grid">
        {certifications.map(cert => {
          const c = providerMeta[cert.provider];
          return (
            <div
              class="cert-badge"
              style={`background:${c.bg}; border-left-color:${c.border};`}
            >
              <p class="cert-name" style={`color:${c.text};`}>{cert.name}</p>
              <p class="cert-meta">
                <span class="cert-provider" style={`color:${c.border};`}>{c.label}</span>
                <span class="cert-sep">·</span>
                <span class="cert-date">{cert.date}</span>
              </p>
            </div>
          );
        })}
      </div>
    </section>

  </main>

  <footer class="footer">
    <p>© {new Date().getFullYear()} Joakim Martin Torsvik</p>
  </footer>

</Layout>

<style>
  /* ─── HERO ───────────────────────────────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, #020617 0%, #0f172a 40%, #1e3a8a 100%);
    padding: 4rem 1.5rem;
  }

  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-photo {
    width: 155px;
    height: 155px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.07), 0 16px 40px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .hero-text {
    flex: 1;
    min-width: 260px;
  }

  .hero-name {
    font-size: 2.5rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .hero-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #93c5fd;
    margin-top: 0.5rem;
    letter-spacing: 0.01em;
  }

  .hero-subtitle {
    font-size: 0.88rem;
    color: #bfdbfe;
    margin-top: 0.25rem;
    opacity: 0.8;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(255, 255, 255, 0.09);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .contact-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .lang-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.65rem;
  }

  .lang-chip {
    background: rgba(37, 99, 235, 0.22);
    color: #bfdbfe;
    border: 1px solid rgba(37, 99, 235, 0.4);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 500;
  }

  /* ─── PAGE LAYOUT ────────────────────────────────────────────────────────── */
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.75rem 1.5rem 1rem;
  }

  /* ─── SECTIONS ───────────────────────────────────────────────────────────── */
  .section {
    margin-bottom: 3rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border);
  }

  .section-icon {
    font-size: 1.35rem;
    line-height: 1;
  }

  .section-heading h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.015em;
  }

  /* ─── SKILLS ─────────────────────────────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 0.75rem;
  }

  .skill-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
  }

  .skill-cat-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--blue);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.7rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    background: var(--blue-light);
    color: var(--blue-dark);
    border: 1px solid var(--blue-border);
    border-radius: 6px;
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .tag--edu {
    background: var(--purple-light);
    color: #5b21b6;
    border-color: #ddd6fe;
  }

  /* ─── TIMELINE ───────────────────────────────────────────────────────────── */
  .timeline {
    position: relative;
    padding-left: 1.75rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.42rem;
    top: 0.6rem;
    bottom: 1rem;
    width: 2px;
    background: linear-gradient(to bottom, var(--blue) 0%, #e2e8f0 100%);
    border-radius: 2px;
  }

  .timeline-entry {
    position: relative;
    margin-bottom: 1.25rem;
  }

  .timeline-dot {
    position: absolute;
    left: -1.45rem;
    top: 1.45rem;
    width: 13px;
    height: 13px;
    background: var(--blue);
    border-radius: 50%;
    border: 2.5px solid var(--page-bg);
    box-shadow: 0 0 0 2px var(--blue);
  }

  /* ─── EXPERIENCE CARDS ───────────────────────────────────────────────────── */
  .exp-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .exp-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .exp-card--consulting {
    border-top: 3px solid var(--blue);
  }

  .exp-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .exp-logo {
    width: 54px;
    height: 54px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: #f8fafc;
    padding: 5px;
    flex-shrink: 0;
  }

  .exp-role {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .exp-employer {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--blue);
    margin-top: 0.1rem;
  }

  .exp-period {
    font-size: 0.79rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  /* ─── BULLETS ────────────────────────────────────────────────────────────── */
  .bullets {
    list-style: none;
    padding: 0;
    margin-top: 0.5rem;
  }

  .bullets li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .bullets li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--blue);
    font-size: 0.72rem;
    top: 0.22rem;
  }

  /* ─── ENGAGEMENTS ────────────────────────────────────────────────────────── */
  .engagements {
    margin-top: 0.8rem;
  }

  .engagements-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .engagement-card {
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
    margin-bottom: 0.6rem;
    transition: background 0.2s;
  }

  .engagement-card:hover {
    background: #f1f5f9;
  }

  .engagement-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .engagement-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: white;
    padding: 3px;
    flex-shrink: 0;
  }

  .engagement-logo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e2e8f0;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 1rem;
    border-radius: 6px;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .engagement-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .engagement-client {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue);
    margin-top: 0.1rem;
  }

  .engagement-period {
    font-size: 0.77rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  /* ─── EDUCATION ──────────────────────────────────────────────────────────── */
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .edu-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    border-left: 4px solid var(--purple);
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .edu-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .edu-degree {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .edu-institution {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--purple);
    margin-top: 0.1rem;
  }

  .edu-period {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  /* ─── CERTIFICATIONS ─────────────────────────────────────────────────────── */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 0.65rem;
  }

  .cert-badge {
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.05rem;
    border-left-width: 4px;
    border-left-style: solid;
    border-top: 1px solid rgba(0, 0, 0, 0.04);
    border-right: 1px solid rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cert-badge:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .cert-name {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .cert-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .cert-provider {
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .cert-sep {
    color: #94a3b8;
    font-size: 0.7rem;
  }

