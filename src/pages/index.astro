---
import Layout from '../layouts/Layout.astro';
import {
  summary,
  socialLinks,
  experiences,
  education,
  certifications,
  providerMeta,
  skillCategories,
} from '../data/cv.ts';

// Prefix public/ assets with the deployment base path
const asset = (path: string) => import.meta.env.BASE_URL + path.replace(/^\//, '');
---

<Layout>

  <!-- ═══════════════════════════════ HERO ═══════════════════════════════════ -->
  <header class="hero">
    <div class="hero-inner">
      <img src={asset('/profile.jpg')} alt="Joakim Martin Torsvik" class="hero-photo" />
      <div class="hero-text">
        <h1 class="hero-name">Joakim Martin Torsvik</h1>
        <p class="hero-title">Data Scientist · Data Engineer · Technical Lead</p>
        <p class="hero-subtitle">Data Platform Architecture &amp; Development · Agile Team Management · Product Development</p>

        <div class="contact-row">
          <span class="contact-pill">📍 Oslo, Norway</span>
          <a href="tel:+4745467412" class="contact-pill">📞 +47 454 67 412</a>
          <a href="mailto:joakim.torsvik@icloud.com" class="contact-pill">✉️ joakim.torsvik@icloud.com</a>
          {socialLinks.map(link => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="contact-pill contact-pill--social">
              {link.icon === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
              )}
              {link.icon === 'github' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.48 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 013.01-.4c1.02 0 2.04.13 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.3c0 .32.22.69.82.57C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
              )}
              {link.label}
            </a>
          ))}
        </div>

        <div class="lang-row">
          <span class="lang-chip">🇳🇴 Norwegian (native)</span>
          <span class="lang-chip">🇬🇧 English (fluent)</span>
          <span class="lang-chip">🇪🇸 Spanish (B2)</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ══════════════════════════ STICKY NAV ══════════════════════════════════ -->
  <nav class="site-nav" aria-label="CV sections">
    <div class="site-nav-inner">
      <div class="nav-links">
        <a href="#summary"        class="nav-link">Profile</a>
        <a href="#skills"         class="nav-link">Skills</a>
        <a href="#experience"     class="nav-link">Experience</a>
        <a href="#education"      class="nav-link">Education</a>
        <a href="#certifications" class="nav-link">Certifications</a>
      </div>
      <button id="download-btn" class="btn-download" aria-label="Download CV as PDF">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download PDF
      </button>
    </div>
  </nav>

  <main class="page">

    <!-- ══════════════════════════ SUMMARY ═════════════════════════════════ -->
    <section class="section" id="summary">
      <div class="section-heading">
        <span class="section-icon">👤</span>
        <h2>Profile</h2>
      </div>
      <div class="summary-card">
        <p class="summary-text">{summary}</p>
      </div>
    </section>

    <!-- ══════════════════════════ SKILLS ══════════════════════════════════ -->
    <section class="section" id="skills">
      <div class="section-heading">
        <span class="section-icon">🛠️</span>
        <h2>Technical Proficiencies</h2>
      </div>
      <div class="skills-grid">
        {skillCategories.map(cat => (
          <div class="skill-card">
            <p class="skill-cat-label">{cat.name}</p>
            <div class="tags">
              {cat.skills.map(s => <span class="tag">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════ EXPERIENCE ════════════════════════════════ -->
    <section class="section" id="experience">
      <div class="section-heading">
        <span class="section-icon">💼</span>
        <h2>Professional Experience</h2>
      </div>
      <div class="timeline">
        {experiences.map(exp => (
          <div class="timeline-entry">
            <div class="timeline-dot" />
            <div class:list={['exp-card', exp.type === 'consulting' && 'exp-card--consulting']}>

              <div class="exp-header">
                <img src={asset(exp.logo)} alt={exp.employer} class="exp-logo" />
                <div>
                  <p class="exp-role">{exp.role}</p>
                  <p class="exp-employer">{exp.employer}</p>
                  <p class="exp-period">{exp.period}</p>
                </div>
              </div>

              {exp.type === 'direct' && exp.bullets && (
                <ul class="bullets">
                  {exp.bullets.map(b => <li>{b}</li>)}
                </ul>
              )}

              {exp.type === 'consulting' && exp.engagements && (
                <div class="engagements">
                  <p class="engagements-label">Client Engagements</p>
                  {exp.engagements.map(eng => (
                    <div class="engagement-card">
                      <div class="engagement-header">
                        {eng.logo
                          ? <img src={asset(eng.logo)} alt={eng.client} class="engagement-logo" />
                          : <div class="engagement-logo engagement-logo--placeholder">?</div>
                        }
                        <div>
                          <p class="engagement-title">{eng.title}</p>
                          <p class="engagement-client">
                            {eng.client}
                            {eng.industry && <span class="engagement-industry"> · {eng.industry}</span>}
                          </p>
                          <p class="engagement-period">{eng.period}</p>
                        </div>
                      </div>
                      <ul class="bullets">
                        {eng.bullets.map(b => <li>{b}</li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              )}

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════════════════════ EDUCATION ════════════════════════════════ -->
    <section class="section" id="education">
      <div class="section-heading">
        <span class="section-icon">🎓</span>
        <h2>Education</h2>
      </div>
      <div class="edu-list">
        {education.map(edu => (
          <div class="edu-card">
            <div class="edu-header">
              <div>
                <p class="edu-degree">{edu.degree}</p>
                <p class="edu-institution">{edu.institution}</p>
                <p class="edu-period">{edu.period} · Grade average: {edu.grade}</p>
              </div>
            </div>
            <div class="tags" style="margin-top: 0.75rem;">
              {edu.subjects.map(s => <span class="tag tag--edu">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════ CERTIFICATIONS ═════════════════════════════ -->
    <section class="section" id="certifications">
      <div class="section-heading">
        <span class="section-icon">📜</span>
        <h2>Technical Certifications</h2>
      </div>
      <div class="cert-grid">
        {certifications.map(cert => {
          const c = providerMeta[cert.provider];
          return (
            <div
              class="cert-badge"
              style={`background:${c.bg}; border-left-color:${c.border};`}
            >
              <p class="cert-name" style={`color:${c.text};`}>{cert.name}</p>
              <p class="cert-meta">
                <span class="cert-provider" style={`color:${c.border};`}>{c.label}</span>
                <span class="cert-sep">·</span>
                <span class="cert-date">{cert.date}</span>
              </p>
            </div>
          );
        })}
      </div>
    </section>

  </main>

  <footer class="footer">
    <p>© {new Date().getFullYear()} Joakim Martin Torsvik</p>
  </footer>

</Layout>

<script>
  // ── Download PDF ─────────────────────────────────────────────────────────
  document.getElementById('download-btn')?.addEventListener('click', () => window.print());

  // ── Active nav link via Intersection Observer ────────────────────────────
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const navLinks  = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

  const observer = new IntersectionObserver(
    entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          navLinks.forEach(l =>
            l.classList.toggle('active', l.getAttribute('href') === `#${entry.target.id}`)
          );
        }
      }
    },
    { rootMargin: '-15% 0px -70% 0px' },
  );

  sections.forEach(s => observer.observe(s));
</script>

<style>
  /* ─── HERO ───────────────────────────────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, #020617 0%, #0f172a 40%, #1e3a8a 100%);
    padding: 4rem 1.5rem;
  }

  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .hero-photo {
    width: 155px;
    height: 155px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.07), 0 16px 40px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }

  .hero-text {
    flex: 1;
    min-width: 260px;
  }

  .hero-name {
    font-size: 2.5rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .hero-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #93c5fd;
    margin-top: 0.5rem;
    letter-spacing: 0.01em;
  }

  .hero-subtitle {
    font-size: 0.88rem;
    color: #bfdbfe;
    margin-top: 0.25rem;
    opacity: 0.8;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: rgba(255, 255, 255, 0.09);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .contact-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .lang-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.65rem;
  }

  .lang-chip {
    background: rgba(37, 99, 235, 0.22);
    color: #bfdbfe;
    border: 1px solid rgba(37, 99, 235, 0.4);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 500;
  }

  /* ─── STICKY NAV ─────────────────────────────────────────────────────────── */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  }

  .site-nav-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .nav-links {
    display: flex;
    gap: 0;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar { display: none; }

  .nav-link {
    padding: 0.85rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .nav-link:hover { color: var(--text); }

  .nav-link.active {
    color: var(--blue);
    border-bottom-color: var(--blue);
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--blue);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.45rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font);
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s, transform 0.1s;
  }

  .btn-download:hover  { background: var(--blue-dark); transform: translateY(-1px); }
  .btn-download:active { transform: translateY(0); }

  /* ─── PAGE LAYOUT ────────────────────────────────────────────────────────── */
  .page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.75rem 1.5rem 1rem;
  }

  /* ─── SECTIONS ───────────────────────────────────────────────────────────── */
  .section {
    margin-bottom: 3rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border);
  }

  .section-icon {
    font-size: 1.35rem;
    line-height: 1;
  }

  .section-heading h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.015em;
  }

  /* ─── SUMMARY ────────────────────────────────────────────────────────────── */
  .summary-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
    border-left: 4px solid var(--blue);
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .summary-text {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  /* ─── SKILLS ─────────────────────────────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 0.75rem;
  }

  .skill-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
  }

  .skill-cat-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--blue);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.7rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    background: var(--blue-light);
    color: var(--blue-dark);
    border: 1px solid var(--blue-border);
    border-radius: 6px;
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .tag--edu {
    background: var(--purple-light);
    color: #5b21b6;
    border-color: #ddd6fe;
  }

  /* ─── TIMELINE ───────────────────────────────────────────────────────────── */
  .timeline {
    position: relative;
    padding-left: 1.75rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.42rem;
    top: 0.6rem;
    bottom: 1rem;
    width: 2px;
    background: linear-gradient(to bottom, var(--blue) 0%, #e2e8f0 100%);
    border-radius: 2px;
  }

  .timeline-entry {
    position: relative;
    margin-bottom: 1.25rem;
  }

  .timeline-dot {
    position: absolute;
    left: -1.45rem;
    top: 1.45rem;
    width: 13px;
    height: 13px;
    background: var(--blue);
    border-radius: 50%;
    border: 2.5px solid var(--page-bg);
    box-shadow: 0 0 0 2px var(--blue);
  }

  /* ─── EXPERIENCE CARDS ───────────────────────────────────────────────────── */
  .exp-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .exp-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .exp-card--consulting {
    border-top: 3px solid var(--blue);
  }

  .exp-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .exp-logo {
    width: 54px;
    height: 54px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: #f8fafc;
    padding: 5px;
    flex-shrink: 0;
  }

  .exp-role {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .exp-employer {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--blue);
    margin-top: 0.1rem;
  }

  .exp-period {
    font-size: 0.79rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  /* ─── BULLETS ────────────────────────────────────────────────────────────── */
  .bullets {
    list-style: none;
    padding: 0;
    margin-top: 0.5rem;
  }

  .bullets li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .bullets li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--blue);
    font-size: 0.72rem;
    top: 0.22rem;
  }

  /* ─── ENGAGEMENTS ────────────────────────────────────────────────────────── */
  .engagements {
    margin-top: 0.8rem;
  }

  .engagements-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .engagement-card {
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
    margin-bottom: 0.6rem;
    transition: background 0.2s;
  }

  .engagement-card:hover {
    background: #f1f5f9;
  }

  .engagement-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .engagement-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: white;
    padding: 3px;
    flex-shrink: 0;
  }

  .engagement-logo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e2e8f0;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 1rem;
    border-radius: 6px;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .engagement-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .engagement-client {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue);
    margin-top: 0.1rem;
  }

  .engagement-industry {
    font-weight: 400;
    color: var(--text-muted);
  }

  .engagement-period {
    font-size: 0.77rem;
    color: var(--text-muted);
    margin-top: 0.1rem;
  }

  /* ─── EDUCATION ──────────────────────────────────────────────────────────── */
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .edu-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    border-left: 4px solid var(--purple);
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .edu-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .edu-degree {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .edu-institution {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--purple);
    margin-top: 0.1rem;
  }

  .edu-period {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  /* ─── CERTIFICATIONS ─────────────────────────────────────────────────────── */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 0.65rem;
  }

  .cert-badge {
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.05rem;
